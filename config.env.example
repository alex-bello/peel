# peel configuration. Copy to config.env (gitignored) and edit:
#   cp config.env.example config.env
# This file is sourced by bash, so quote values that contain spaces. No secrets belong here.
# Every key is optional; an empty value means the default shown.

# Hostname the Pi advertises, reachable as <hostname>.local via mDNS.
PRINTER_HOSTNAME="labels"

# --- Installation -----------------------------------------------------------

# auto = apt if the lprint package exists for this OS release, else snap.
# Or force one: apt | snap
# The snap runs the server as snap-managed root (per upstream docs); apt runs it as the
# dedicated non-root user "lprint". Only an apt install gets that user.
INSTALL_METHOD="auto"

# Snap name used when installing via snap.
SNAP_NAME="lprint"

# --- Server -----------------------------------------------------------------

# TCP port for the LPrint server and its web UI, passed as `-o server-port=<port>`.
# Pinned so URLs survive restarts and card swaps (per upstream docs, LPrint's own
# default is random in 8000-8999; not observed directly, because we pin it).
# 1-65535; a dedicated non-root user cannot bind ports below 1024.
# Always applied on the apt path, where peel installs its own systemd unit (below 1024 is
# rejected there). Ignored with the snap, whose unit peel does not modify; setup.sh warns and
# prints the port actually in use.
LISTEN_PORT="8631"

# Extra arguments appended to `lprint server`, e.g. "-o log-level=debug". Plain option
# characters only; do not set server-port here. Applied on the apt path, ignored with the snap, like LISTEN_PORT.
SERVER_OPTIONS=""

# --- Printer ----------------------------------------------------------------

# Name of the printer queue on the LPrint server (letters, digits, '_' and '-'). It also names
# the printer's web UI and IPP path, so changing it changes those URLs. The default is the name
# LPrint itself gave the 450 Turbo when it auto-added it on the test Pi (OBSERVED:
# "DYMO LabelWriter 450 Turbo", whose queue name is DYMO_LabelWriter_450_Turbo), so a default
# install keeps the URL the server would have had anyway. Changing it later deletes the old queue
# and adds the new one.
PRINTER_NAME="DYMO_LabelWriter_450_Turbo"

# Driver and USB device URI. Leave both empty: setup.sh asks LPrint which driver it pairs with the
# attached DYMO printer and uses that printer's URI. Set them only to override, for example
# DEVICE_URI when two DYMO printers are attached (the serial number in the URI tells them
# apart), or DRIVER to force a different one. List what LPrint sees with scripts/discover.sh.
# Changing either one deletes and re-adds the printer (once); a re-run with no change does nothing.
DRIVER=""
DEVICE_URI=""

# The label stock that is loaded, as an LPrint media name (applied with `lprint modify -o media-ready=`, which
# on the test Pi also set the default media).
# List the valid names for your printer with scripts/discover.sh; names look like
# oe_address-label_1.125x3.5in or oe_shipping-label_2.125x4in. Empty or unknown: setup.sh warns,
# prints the valid names, and leaves the printer's current media alone.
MEDIA_READY=""

# Extra printer options applied with `lprint modify`, space separated NAME=VALUE (plain
# characters only), e.g. "print-darkness=50 print-quality=high". Do not set media or media-ready
# here; use MEDIA_READY. The names LPrint accepts are listed by scripts/discover.sh under
# "Print job options" and "Printer options". Not read back from the printer: a change is detected
# by comparing with what setup.sh last applied.
PRINTER_OPTIONS=""
