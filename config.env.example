# peel configuration. Copy to config.env (gitignored) and edit:
#   cp config.env.example config.env
# This file is sourced by bash, so quote values that contain spaces. No secrets belong here.
# Every key is optional; an empty value means the default shown.

# Hostname the Pi advertises, reachable as <hostname>.local via mDNS.
PRINTER_HOSTNAME="labels"

# --- Installation -----------------------------------------------------------

# auto = apt if the lprint package exists for this OS release, else snap.
# Or force one: apt | snap
# The snap runs the server as snap-managed root (per upstream docs); apt runs it as the
# dedicated non-root user "lprint". Only an apt install gets that user.
INSTALL_METHOD="auto"

# Snap name used when installing via snap.
SNAP_NAME="lprint"

# --- Server -----------------------------------------------------------------

# TCP port for the LPrint server and its web UI, passed as `-o server-port=<port>`.
# Pinned so URLs survive restarts and card swaps (per upstream docs, LPrint's own
# default is random in 8000-8999; not observed directly, because we pin it).
# 1-65535; a dedicated non-root user cannot bind ports below 1024.
# Always applied on the apt path, where peel installs its own systemd unit (below 1024 is
# rejected there). Ignored with the snap, whose unit peel does not modify; setup.sh warns and
# prints the port actually in use.
LISTEN_PORT="8631"

# Extra arguments appended to `lprint server`, e.g. "-o log-level=debug". Plain option
# characters only; do not set server-port here. Applied on the apt path, ignored with the snap, like LISTEN_PORT.
SERVER_OPTIONS=""
