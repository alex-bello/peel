# peel configuration. Copy to config.env (gitignored) and edit:
#   cp config.env.example config.env
# This file is sourced by bash, so quote values that contain spaces.

# --- Printer ----------------------------------------------------------------

# Name of the printer in LPrint. It becomes part of the IPP URL
# (/ipp/print/<name>) and the name clients show. Letters, digits, '_' and '-' only.
PRINTER_NAME="DYMO_450_Turbo"

# Hostname the Pi advertises, reachable as <hostname>.local via mDNS.
PRINTER_HOSTNAME="labels"

# Driver name from `lprint drivers`. Leave empty to auto-detect the
# "450 Turbo" (setup.sh fails if that matches zero or several drivers).
DRIVER=""

# USB device URI from `lprint devices`. Leave empty to auto-detect the DYMO
# (setup.sh fails if zero or several DYMO printers are attached).
DEVICE_URI=""

# Media loaded in the printer, as named by `lprint options -d <printer>`.
# Run scripts/discover.sh after the first setup to list valid names, then set
# this and re-run setup.sh. Empty = keep the driver default and print the list.
MEDIA_READY=""

# Extra space-separated key=value printer options applied with `lprint modify`,
# e.g. "print-darkness=50 print-speed=1". Names come from `lprint options`.
PRINTER_OPTIONS=""

# --- Installation -----------------------------------------------------------

# auto = apt if the lprint package exists for this OS release, else snap.
# Or force one: apt | snap
INSTALL_METHOD="auto"

# Snap name used when installing via snap.
SNAP_NAME="lprint"

# --- Server -----------------------------------------------------------------

# TCP port for the LPrint server / web UI. Empty = LPrint's default
# (scripts/discover.sh and the end of setup.sh print the port actually in use).
# Only applied when peel installs its own systemd unit.
LISTEN_PORT=""

# Extra arguments appended to `lprint server`, e.g. "-o log-level=debug".
# Only applied when peel installs its own systemd unit.
SERVER_OPTIONS=""
